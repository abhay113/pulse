# ==============================================================================
# PULSE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development or reference it when configuring
# GitHub Actions Secrets and Repository Variables.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the local Node.js API server (default: 3001)
PORT=3001

# Port for the local Vite web development server (default: 5173)
VITE_PORT=5173

# Local proxy target for Vite to route /api/* requests (default: http://localhost:3001)
VITE_API_TARGET=http://localhost:3001

# Upstream API origin for local Cloudflare Worker proxying (default: http://localhost:3001)
API_ORIGIN=http://localhost:3001

# HMAC-SHA256 Secret for signing stateless round tokens
# (A default 32-char fallback is used locally if not provided)
HMAC_SECRET=pulse-dev-secret-fallback-key-32-chars-long

# Round Token Time-To-Live in milliseconds (default: 300000 = 5 minutes)
TOKEN_TTL_MS=300000

# Number of game pads (default: 4 for cyan, magenta, lime, amber)
PAD_COUNT=4

# Application semantic version
APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE CREDENTIALS & WORKER CONFIGURATION
# ------------------------------------------------------------------------------
# Cloudflare Account ID (Found in Cloudflare Dashboard URL or Overview)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare API Token (Requires: Workers Scripts:Edit, Workers Routes:Edit)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Cloudflare Workers Subdomain (e.g., yourname.workers.dev)
CLOUDFLARE_SUBDOMAIN=your-subdomain

# Deployed Cloudflare Worker Base URL (used for optional end-to-end smoke testing)
CLOUDFLARE_WORKER_URL=https://pulse.your-subdomain.workers.dev

# ------------------------------------------------------------------------------
# 3. AWS INFRASTRUCTURE & OIDC DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# AWS Target Region (default: us-east-1)
AWS_REGION=us-east-1

# S3 Bucket holding the Terraform remote state
TF_STATE_BUCKET=pulse-tfstate-xxxxxxxx

# IAM Role assumed by GitHub Actions via keyless OpenID Connect (OIDC)
AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/pulse-prod-github-deployer

# Project and Environment Identifiers
PROJECT_NAME=pulse
ENVIRONMENT=prod

# Optional Monthly Cost Budget in USD (default: 10.0)
BUDGET_LIMIT_USD=10.0

# Optional notification email for AWS Budget alerts (leave empty to skip)
ALERT_EMAIL=

# Amazon SES Configuration for Game Score Notifications
SES_FROM_EMAIL=pulse@bevdamanus.in
SES_TO_EMAIL=abhaychavan346@gmail.com
