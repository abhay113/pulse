{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "API_ORIGIN": "http://localhost:3001"
  },
  "env": {
    "dev": {
      "name": "pulse-dev",
      "vars": {
        "API_ORIGIN": "https://placeholder-dev.execute-api.us-east-1.amazonaws.com"
      }
    },
    "prod": {
      "name": "pulse-prod",
      "vars": {
        "API_ORIGIN": "https://placeholder-prod.execute-api.us-east-1.amazonaws.com"
      }
    }
  }
}

